# TIDAL login for the heart button (add the playing track to your TIDAL favourites).
# Copy this file to app/tidal.local.env, fill in the Client ID of your own app from developer.tidal.com
# and rebuild with scripts/build-app.sh. The file stays out of git.
#
# In your app on developer.tidal.com:
# - add the redirect URI below (the app listens for it on 127.0.0.1 only while you log in);
# - enable the scopes collection.read, collection.write and search.read.
# The login uses OAuth with PKCE, so no Client Secret is needed. Never put one here.

TIDAL_CLIENT_ID=
TIDAL_REDIRECT_URI=http://127.0.0.1:53682/callback
# Optional, this is the default:
# TIDAL_SCOPES=collection.read collection.write search.read
